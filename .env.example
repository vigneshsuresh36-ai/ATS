NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# --- Firebase Admin (server only) ---
FIREBASE_ADMIN_CREDENTIALS_PATH=./your-firebase-adminsdk.json
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Initial administrator for a new, empty customer installation only.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
GOOGLE_CALENDAR_ENABLED=0
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# --- AI and automation (server only; never use NEXT_PUBLIC_ for these) ---
OPENAI_API_KEY=
# Set a Responses API model available to your OpenAI project.
OPENAI_MODEL=
# Optional server-side web search for Talent Pool X-ray results.
BRAVE_SEARCH_API_KEY=
RESEND_API_KEY=
# Sender address on a verified Resend domain, e.g. STARSHIP <hiring@example.com>
AUTOMATION_FROM_EMAIL=
# Random secret for the authenticated background runner; set the same value on your scheduler.
CRON_SECRET=

